{
  "dt:&cpu0:compatible": "espressif,riscv",
  "dt:&cpu0:clock-frequency": "160_000_000",

  "include": "runtime-espidf.json",

  "runtime":
  {
    "common_required_switches": ["-march=rv32imc", "-mabi=ilp32"],
    "linker_required_switches": ["-nostartfiles", "-nolibc"],
  },

  "tasking":
  {
    "files":
    {
      "a-intnam.ads": { "crate": "espidf_gnat_runtime", "path": "source/a-intnam__esp32c3.ads" },
    },
  },

  "scenarios":
  {
    "Add_Math_Lib": "softfloat",
  },
}
