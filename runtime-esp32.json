{
  "dt:&cpu0:compatible": "espressif,xtensa-lx6",
  "dt:&cpu0:clock-frequency": "240_000_000",

  "include": "runtime-espidf.json",

  "runtime":
  {
    "common_required_switches": ["-mlongcalls"],
    "linker_required_switches": ["-nostartfiles", "-nolibc"],
  },

  "tasking":
  {
    "files":
    {
      "a-intnam.ads": { "crate": "espidf_gnat_runtime", "path": "source/a-intnam__esp32.ads" },
    },
  },

  "scenarios":
  {
    "Add_Math_Lib": "hardfloat",
  },
}
